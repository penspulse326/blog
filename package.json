{
  "name": "",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:js": "oxlint src",
    "lint:js:fix": "oxlint --fix src",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
