---
import type { HTMLAttributes } from "astro/types";

type TitleElement = "h2" | "h3" | "h4" | "span";

export interface Props extends HTMLAttributes<"h3"> {
  as?: TitleElement;
  class?: string;
}

const { as: Tag = "h3", class: className, ...rest } = Astro.props;
---

<Tag data-slot="card-title" class={className} {...rest}>
  <slot />
</Tag>
