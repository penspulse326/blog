---
import { Icon } from 'astro-icon/components';

interface Props {
  class?: string;
  enableHistoryBack?: boolean;
  href?: string;
  text?: string;
  variant?: 'compact' | 'regular';
}

const {
  class: className = '',
  enableHistoryBack = false,
  href = '/posts',
  text = '返回',
  variant = 'compact',
} = Astro.props;

const isCompact = variant === 'compact';
---

<a
  class:list={[
    'inline-flex items-center gap-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 font-medium transition-all group shadow-xs cursor-pointer',
    isCompact
      ? 'px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white text-sm dark:bg-slate-800/90'
      : 'px-4 py-2 text-slate-800 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white text-sm',
    className,
  ]}
  data-history-back={enableHistoryBack ? 'true' : undefined}
  href={href}
>
  <Icon class="group-hover:-translate-x-1 transition-transform" name="bi:arrow-left" />
  <span>{text}</span>
</a>

<script>
  const buttons = document.querySelectorAll<HTMLAnchorElement>('a[data-history-back="true"]');
  buttons.forEach((button) => {
    if (document.referrer && document.referrer.includes(window.location.host)) {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        history.back();
      });
    }
  });
</script>
