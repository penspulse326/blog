---
interface ExperienceItem {
  icon: string;
  title: string;
}

interface Props {
  experiences?: ExperienceItem[];
}

const defaultExperiences: ExperienceItem[] = [
  { icon: '💻', title: '前端工程師' },
  { icon: '✡️', title: '六角學院 - 專題教練' },
];

const { experiences = defaultExperiences } = Astro.props;
---

<article
  class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-800 transition-all duration-300"
>
  <h2 class="text-lg font-bold text-slate-900 dark:text-white card-title-underline mb-4">經歷</h2>
  <ul class="space-y-3 text-sm text-slate-700 dark:text-slate-300">
    {
      experiences.map((exp) => (
        <li class="flex items-center gap-3">
          <span class="text-xl">{exp.icon}</span>
          <span class="font-medium">{exp.title}</span>
        </li>
      ))
    }
  </ul>
</article>
