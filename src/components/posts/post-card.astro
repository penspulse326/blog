---
import { Icon } from 'astro-icon/components';

import type { PostEntry } from '../../utils/posts';
import { formatDate } from '../../utils/date';
import PostExcerpt from './post-excerpt.astro';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = post;
---

<article class="group py-8 first:pt-0 last:pb-0 transition-all">
  <h2 class="text-2xl font-bold mb-4 mt-0!">
    <a
      class="text-slate-900 dark:text-white hover:text-primary dark:hover:text-primary transition-colors leading-tight block"
      href={post.url}
    >
      {post.frontmatter.title}
    </a>
  </h2>

  {
    post.frontmatter.date && (
      <div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400 mb-4">
        <span class="flex items-center gap-1.5">
          <Icon name="bi:calendar3" />
          {formatDate(post.frontmatter.date)}
        </span>
        {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
          <span class="flex items-center gap-1.5 overflow-hidden">
            <Icon name="bi:tags" />
            <div class="flex gap-2">
              {post.frontmatter.tags.map((tag: string) => (
                <a class="hover:text-primary transition-colors" href={`/posts/tag/${encodeURIComponent(tag)}`}>
                  #{tag}
                </a>
              ))}
            </div>
          </span>
        )}
      </div>
    )
  }

  <div class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6 prose dark:prose-invert max-w-none">
    <PostExcerpt Content={Content} />
  </div>

  <a class="inline-flex items-center font-bold text-primary group-hover:gap-2 transition-all" href={post.url}>
    閱讀更多 <Icon class="ml-1" name="bi:arrow-right" />
  </a>
</article>
