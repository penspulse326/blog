---
import type { MarkdownHeading } from 'astro';

import type { CategoryWithContent } from '../utils/content';

import ContentSidebar from '../components/content-nav/content-sidebar.astro';
import ImageZoom from '../components/common/image-zoom.astro';
import TableOfContents from '../components/toc/table-of-contents.astro';
import Layout from './default-layout.astro';

interface Props {
  activeId?: string;
  ariaLabel?: string;
  description?: string;
  headings?: MarkdownHeading[];
  navigation?: CategoryWithContent[];
  ogImage?: string;
  showToc?: boolean;
  title: string;
}

const { activeId, ariaLabel, description, headings = [], navigation, ogImage, showToc = true, title } = Astro.props;
const hasCustomSidebar = Astro.slots.has('sidebar');
---

<Layout description={description} ogImage={ogImage} title={title}>
  <div class="max-w-7xl mx-auto px-4 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-4">
      <!-- 側邊導覽 -->
      <aside class="content-sidebar hidden lg:block shrink-0 mt-4 lg:mt-8">
        {
          hasCustomSidebar ? (
            <slot name="sidebar" />
          ) : navigation ? (
            <ContentSidebar activeId={activeId} ariaLabel={ariaLabel} navigation={navigation} />
          ) : null
        }
      </aside>

      <!-- 內文 -->
      <main class="grow mt-4 lg:mt-8 min-w-0 relative z-0">
        <slot />
      </main>

      <!-- 目錄 -->
      {
        showToc && (
          <aside class="content-toc grow hidden lg:block min-w-45 mt-8">
            <TableOfContents headings={headings} variant="desktop" />
          </aside>
        )
      }
    </div>
  </div>
  <ImageZoom />
</Layout>

<style>
  .content-sidebar {
    @media (width >= 1024px) {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      z-index: 40;
    }

    /* 捲軸樣式 */
    &::-webkit-scrollbar {
      width: 4px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      background: var(--color-slate-300);
      border-radius: 99px;

      &:where(.dark, .dark *) {
        background: var(--color-slate-700);
      }
    }
  }

  main {
    margin-bottom: 8rem;
  }

  .content-toc {
    @media (width >= 1024px) {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      align-self: flex-start;
      overflow-y: auto;
    }

    /* 捲軸樣式 */
    &::-webkit-scrollbar {
      width: 4px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      background: var(--color-slate-300);
      border-radius: 99px;

      &:where(.dark, .dark *) {
        background: var(--color-slate-700);
      }
    }
  }
</style>
