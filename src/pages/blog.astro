---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Tag from "../components/Tag.astro";

const essays = [
  {
    title: "Building a Fault-Tolerant Raft Consensus Engine in Rust",
    slug: "/blog/raft-consensus-engine",
    date: "2026-10-18",
    readingTime: "14 min read",
    tags: ["systems", "rust", "consensus"],
    excerpt:
      "A deep dive into implementing state machine replication, handling network partitions, and eliminating split-brain anomalies in distributed consensus.",
  },
  {
    title: "Zero-Copy Deserialization and Memory Alignment in Storage Pipelines",
    slug: "/blog/zero-copy-storage",
    date: "2026-09-02",
    readingTime: "18 min read",
    tags: ["storage", "performance", "memory"],
    excerpt:
      "Analyzing cache-line eviction, SIMD vectorization, and struct padding to achieve sub-microsecond serialization over high-throughput NVMe streams.",
  },
  {
    title: "Postmortem: Debugging a Cascading Tail-Latency Spike in Distributed Cache",
    slug: "/blog/tail-latency-postmortem",
    date: "2026-08-14",
    readingTime: "11 min read",
    tags: ["postmortem", "sre", "networking"],
    excerpt:
      "How connection pool saturation and TCP window exhaustion triggered exponential retry storms across 40 microservice clusters.",
  },
  {
    title: "Deterministic Concurrency Testing with Thread Sanitizer and Miri",
    slug: "/blog/deterministic-concurrency-testing",
    date: "2026-07-28",
    readingTime: "16 min read",
    tags: ["rust", "concurrency", "testing"],
    excerpt:
      "Eliminating Heisenbugs in lock-free queue implementations through simulated scheduler perturbation and memory access tracing.",
  },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Pen's Pulse — 技術文章典藏。分散式系統架構、高吞吐儲存引擎與底層架構實踐。"
    />
    <title>文章 — Pen's Pulse</title>
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <Header currentPath="/blog" />

    <main id="main-content">
      <Breadcrumb items={[{ label: "文章" }]} />

      <header class="section-header">
        <h1 class="page-title">文章</h1>
        <p class="page-tagline">
          記錄分散式架構、底層儲存引擎與系統可靠性的長篇工程隨筆與事故覆盤。
        </p>
      </header>

      <section class="essay-list-section">
        <div class="essay-list">
          {essays.map((essay) => (
            <article class="essay-card">
              <div class="essay-meta">
                <time class="essay-date">{essay.date}</time>
                <span class="meta-separator">·</span>
                <span class="essay-reading-time">{essay.readingTime}</span>
              </div>
              <h2 class="essay-title">
                <a href={essay.slug}>{essay.title}</a>
              </h2>
              <p class="essay-excerpt">{essay.excerpt}</p>
              <div class="tag-row">
                {essay.tags.map((tag) => (
                  <Tag prefix="#" label={tag} />
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .section-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: var(--step-3);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin-bottom: 0.75rem;
  }

  .page-tagline {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .essay-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .essay-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
    margin-inline: -1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    transition:
      border-color var(--motion-duration) var(--motion-ease),
      background-color var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 34%, transparent);
      background-color: color-mix(in oklab, var(--muted) 45%, transparent);
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--primary) 6%, transparent),
        0 0.75rem 2rem -1.25rem color-mix(in oklab, var(--ring) 24%, transparent);
    }
  }

  .essay-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  .meta-separator {
    opacity: 0.5;
  }

  .essay-title {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);

    a {
      color: var(--foreground);
      text-decoration: none;
      transition: color var(--motion-duration-fast) var(--motion-ease);

      &:hover {
        color: var(--primary);
      }
    }
  }

  .essay-excerpt {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
</style>
