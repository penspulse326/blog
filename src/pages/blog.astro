---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TaxonomyChip from "../components/TaxonomyChip.astro";
import PreviewCard from "../components/PreviewCard.astro";
import { getAllBlogPosts } from "../lib/content";

const allPosts = await getAllBlogPosts();

// Group posts by year
const postsByYearMap = allPosts.reduce((acc: Record<number, typeof allPosts>, post) => {
  const year = post.date ? post.date.getFullYear() : new Date().getFullYear();
  (acc[year] ??= []).push(post);
  return acc;
}, {});

const postsByYear = Object.entries(postsByYearMap)
  .map(([year, posts]) => ({ year: parseInt(year, 10), posts }))
  .sort((a, b) => b.year - a.year);

// Calculate tags and their frequencies
const tagCountMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.tags) {
    tagCountMap.set(tag, (tagCountMap.get(tag) || 0) + 1);
  }
}

const sortedTags = Array.from(tagCountMap.entries())
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => {
    const countDiff = b.count - a.count;
    if (countDiff !== 0) return countDiff;
    return a.tag.localeCompare(b.tag, "zh-Hant");
  });

const displayTags = sortedTags.slice(0, 15);
const numTags = sortedTags.length;
---

<Layout
  title="文章 — Pen's Pulse"
  description="Pen's Pulse — 技術文章典藏。轉職心得、前端工程實踐與開發思考隨筆。"
  currentPath="/blog"
>
  <Breadcrumb items={[{ label: "文章", icon: "blog" }]} />

  {numTags > 0 && (
    <nav class="blog-filters" aria-label="依標籤瀏覽文章">
      <div class="filter-group">
        <h2 class="filter-heading">依標籤瀏覽</h2>
        <div class="filter-chips">
          {displayTags.map(({ tag, count }) => (
            <TaxonomyChip href={`/blog/tags/${tag}`} label={tag} count={count} />
          ))}
        </div>
      </div>
    </nav>
  )}

  <div class="blog-index">
    <p class="post-count">共 {allPosts.length} 篇文章</p>

    {postsByYear.map(({ year, posts }) => (
      <section class="post-year">
        <h2>{year}</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <PreviewCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .blog-filters,
  .filter-group,
  .blog-index,
  .post-year,
  .post-year ul {
    display: flex;
    flex-direction: column;
  }

  .blog-filters {
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  .filter-group {
    gap: var(--space-2xs);
  }

  .filter-heading {
    color: var(--muted-foreground);
    font-size: var(--step-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .blog-index {
    min-block-size: calc(100dvh - 18rem);
    gap: var(--space-xl);
  }

  .post-count {
    color: var(--muted-foreground);
    font-size: var(--step-xs);
    margin: 0;
  }

  .post-year {
    gap: var(--space-s);
  }

  .post-year h2 {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;
  }

  .post-year ul {
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
