---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TaxonomyChip from "../../components/TaxonomyChip.astro";
import Icon from "../../components/Icon.astro";
import { getAllBlogPosts } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post.entry);
---

<Layout title={`${post.title} — Pen's Pulse`} description={post.description} currentPath="/blog">
  <Breadcrumb items={[{ label: "文章", href: "/blog", icon: "blog" }, { label: post.title }]} />

  <article class="article-container">
    <header class="article-header">
      <div class="article-meta">
        {post.dateString && (
          <span class="meta-item">
            <Icon name="publish" size="0.875rem" />
            <time datetime={post.date?.toISOString()}>{post.dateString}</time>
          </span>
        )}
        <span class="meta-item">
          <Icon name="reading-time" size="0.875rem" />
          <span>{post.readingTime}</span>
        </span>
      </div>
      <h1 class="article-title">{post.title}</h1>
      {post.tags.length > 0 && (
        <div class="tag-row">
          {post.tags.map((tag) => (
            <TaxonomyChip href={`/blog/tags/${tag}`} label={tag} />
          ))}
        </div>
      )}
    </header>

    <hr class="divider" />

    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/blog" class="back-link">
        <Icon name="chevron-right" class="rotate-180" size={16} />
        <span>返回文章列表</span>
      </a>
    </footer>
  </article>
</Layout>

<style>
  .article-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin-block-end: var(--space-xl);
  }

  .article-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .article-title {
    font-size: var(--step-3);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--foreground);
    letter-spacing: var(--tracking-tight);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-3xs);
  }

  .divider {
    border: none;
    border-block-start: 1px solid var(--border);
    margin: 0;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
    margin-block-start: var(--space-l);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--foreground);
    }
  }

  .rotate-180 {
    transform: rotate(180deg);
  }
</style>
