---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import TaxonomyChip from "../../components/TaxonomyChip.astro";
import { getAllBlogPosts } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post.entry);

const allPosts = await getAllBlogPosts();
const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<ArticleLayout
  title={`${post.title} — Pen's Pulse`}
  description={post.description}
  currentPath="/blog"
  headings={headings}
  breadcrumbItems={[{ label: "文章", href: "/blog", icon: "blog" }, { label: post.title }]}
  dateString={post.dateString}
  date={post.date}
  readingTime={post.readingTime}
  prevPost={prevPost}
  nextPost={nextPost}
  backLink={{ href: "/blog", label: "返回文章列表" }}
>
  {post.tags.length > 0 && (
    <ul slot="header-bottom" class="post-tags" aria-label="文章標籤">
      {post.tags.map((tag) => (
        <li>
          <TaxonomyChip href={`/blog/tags/${tag}`} label={tag} />
        </li>
      ))}
    </ul>
  )}

  <Content />
</ArticleLayout>
