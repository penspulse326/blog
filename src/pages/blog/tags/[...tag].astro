---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PreviewCard from "../../../components/PreviewCard.astro";
import { getAllBlogPosts, getSortedBlogTags } from "../../../lib/content";

export async function getStaticPaths() {
  const allPosts = await getAllBlogPosts();
  const sortedTags = getSortedBlogTags(allPosts);

  return sortedTags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter((post) => post.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout
  title={`標籤「${tag}」— Pen's Pulse`}
  description={`標籤為「${tag}」的文章列表`}
  currentPath="/blog"
>
  <Breadcrumb
    items={[
      { href: "/blog", label: "文章", icon: "blog" },
      { href: "/blog/tags", label: "標籤", icon: "tags" },
      { label: tag, icon: "hashtag" },
    ]}
  />

  <div class="blog-tag-index">
    <p class="tag-summary">
      標籤「{tag}」，共 {posts.length} 篇文章
    </p>

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <PreviewCard post={post} />
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .blog-tag-index {
    display: flex;
    min-block-size: calc(100dvh - 18rem);
    flex-direction: column;
    gap: var(--space-l);
  }

  .tag-summary {
    color: var(--muted-foreground);
    font-size: var(--step-xs);
    margin: 0;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
