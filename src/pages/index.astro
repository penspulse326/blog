---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Tag from "../components/Tag.astro";
import { getAllBlogPosts, SERIES_META } from "../lib/content";

const allPosts = await getAllBlogPosts();
const essays = allPosts.slice(0, 3);

const featuredPlans = Object.entries(SERIES_META).map(([key, meta]) => ({
  key,
  name: meta.title,
  summary: meta.description,
  metrics: meta.metrics,
  status: meta.status,
  link: "/plans",
}));
---

<Layout
  title="Pen's Pulse — Software Engineer Journal"
  description="Pen's Pulse — Software engineering journal, systems architecture, distributed engines, and digital garden notes."
  currentPath="/"
>
  <!-- Profile Article Matching My Scholar -->
  <article id="profile">
    <header class="profile-header">
      <div class="profile-avatar">
        <Icon name="quill" size={32} />
      </div>
      <div class="profile-content">
        <div class="profile-heading">
          <h1 class="profile-name">Vincent</h1>
          <p class="profile-tagline">
            Systems engineer exploring distributed consensus, high-throughput storage engines, and
            low-latency runtime architecture.
          </p>
        </div>
      </div>
    </header>

    <div class="prose">
      <p>
        Welcome to my digital workshop. This site operates as an editorial archive for rigorous
        engineering essays, postmortems, and technical investigations. Designed with academic
        restraint, high-contrast typography, and zero marketing clutter.
      </p>
    </div>

    <footer class="profile-footer">
      <span class="email-link">
        <Icon name="mail" size={16} />
        <button
          type="button"
          id="copy-email-btn"
          class="copy-email-button"
          data-copy="vincent@example.dev"
          title="Copy email address"
        >
          <span id="copy-email-text">vincent@example.dev</span>
        </button>
      </span>
      <ul class="profile-social-links">
        <li>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="profile-icon-btn"
            aria-label="GitHub"
          >
            <Icon name="github" size={16} />
          </a>
        </li>
        <li>
          <a href="/blog" class="profile-icon-btn" aria-label="Articles Feed">
            <Icon name="rss" size={16} />
          </a>
        </li>
      </ul>
    </footer>
  </article>

  <!-- Latest Technical Essays Section -->
  <section id="essays" class="section-block">
    <div class="section-heading">
      <h2 class="section-title">最新文章</h2>
      <a href="/blog" class="section-more">
        <span>see all</span>
        <Icon name="arrow-right" size={13} />
      </a>
    </div>

    <div class="card-list">
      {essays.map((essay) => (
        <article class="interactive-card">
          <div class="card-meta">
            {essay.dateString && <time class="meta-date">{essay.dateString}</time>}
            {essay.dateString && <span class="meta-dot">·</span>}
            <span class="meta-time">{essay.readingTime}</span>
          </div>
          <h3 class="card-title">
            <a href={`/blog/${essay.slug}`}>{essay.title}</a>
          </h3>
          {essay.description && <p class="card-summary">{essay.description}</p>}
          {essay.tags.length > 0 && (
            <div class="card-tags">
              {essay.tags.map((tag) => (
                <Tag prefix="#" label={tag} href="/blog" />
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Selected Plans Section -->
  <section id="plans" class="section-block">
    <div class="section-heading">
      <h2 class="section-title">主題計劃</h2>
      <a href="/plans" class="section-more">
        <span>see all</span>
        <Icon name="arrow-right" size={13} />
      </a>
    </div>

    <div class="card-list">
      {featuredPlans.map((plan) => (
        <article class="interactive-card">
          <div class="project-head">
            <div class="project-title-group">
              <h3 class="card-title">
                <a href={plan.link}>{plan.name}</a>
              </h3>
              <span class="status-indicator">{plan.status}</span>
            </div>
            <a href={plan.link} class="source-link" aria-label={`View ${plan.name} on Plans page`}>
              <span>查看計劃</span>
              <Icon name="chevron-right" size={12} />
            </a>
          </div>
          <p class="card-summary">{plan.summary}</p>
          <div class="project-metrics">
            <span class="metrics-label">專案特點:</span>
            <span class="metrics-value">{plan.metrics}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Copy Email Script -->
  <script>
    function setupCopyEmail() {
      const copyEmailBtn = document.getElementById("copy-email-btn");
      const copyEmailText = document.getElementById("copy-email-text");
      if (copyEmailBtn && copyEmailText && !copyEmailBtn.dataset.bound) {
        copyEmailBtn.dataset.bound = "true";
        copyEmailBtn.addEventListener("click", async () => {
          const email = copyEmailBtn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(email);
            copyEmailText.textContent = "Copied to clipboard!";
            setTimeout(() => {
              copyEmailText.textContent = "vincent@example.dev";
            }, 2000);
          } catch {
            copyEmailText.textContent = email;
          }
        });
      }
    }
    setupCopyEmail();
    document.addEventListener("astro:page-load", setupCopyEmail);
  </script>
</Layout>

<style>
  /* Profile Layout Matching My Scholar */
  #profile {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);

    @media (width >= 40rem) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-m);
    }
  }

  .profile-avatar {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--primary) 12%, var(--muted));
    border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--border));
    color: var(--primary);
  }

  .profile-content {
    display: flex;
    flex-direction: column;
  }

  .profile-heading {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .profile-name {
    font-size: var(--step-3);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .profile-tagline {
    font-size: var(--step-0);
    color: var(--muted-foreground);
    line-height: 1.5;
    margin: 0;
  }

  .profile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  .copy-email-button {
    font: inherit;
    color: inherit;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--muted-foreground) 40%, transparent);
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
      text-decoration-color: var(--primary);
    }
  }

  .profile-social-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .profile-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    text-decoration: none;
    border: 1px solid var(--border);
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
      border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      background-color: color-mix(in oklab, var(--primary) 8%, transparent);
    }
  }

  /* Section Styling with My Scholar Section-Heading & see all */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2xs);
  }

  .section-title {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      gap var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
      gap: var(--space-2xs);
    }
  }

  /* Card Lists with My Scholar subtle hover depth */
  .card-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .interactive-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border-radius: var(--radius-xl);
    border: 1px solid transparent;
    transition:
      border-color var(--motion-duration) var(--motion-ease),
      background-color var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 34%, transparent);
      background-color: color-mix(in oklab, var(--muted) 45%, transparent);
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--primary) 6%, transparent),
        0 0.75rem 2rem -1.25rem color-mix(in oklab, var(--ring) 24%, transparent);
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  .meta-dot {
    opacity: 0.5;
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    margin: 0;

    a {
      color: var(--foreground);
      text-decoration: none;
      transition: color var(--motion-duration-fast) var(--motion-ease);

      &:hover {
        color: var(--primary);
      }
    }
  }

  .card-summary {
    font-size: var(--step-0);
    color: var(--muted-foreground);
    line-height: 1.65;
    margin: 0;
  }

  .card-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-sm);
    background-color: color-mix(in oklab, var(--primary) 15%, var(--muted));
    color: var(--primary);
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
    }
  }

  .project-metrics {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font-size: var(--step-xs);
    font-family: var(--font-mono);
  }

  .metrics-label {
    color: var(--muted-foreground);
    font-weight: var(--font-weight-medium);
  }

  .metrics-value {
    color: var(--foreground);
  }
</style>
