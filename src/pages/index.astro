---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tag from "../components/Tag.astro";

const essays = [
  {
    title: "Building a Fault-Tolerant Raft Consensus Engine in Rust",
    slug: "/blog",
    date: "2026-10-18",
    readingTime: "14 min read",
    tags: ["systems", "rust", "consensus"],
    excerpt:
      "A deep dive into implementing state machine replication, handling network partitions, and eliminating split-brain anomalies in distributed consensus.",
  },
  {
    title: "Zero-Copy Deserialization and Memory Alignment in Storage Pipelines",
    slug: "/blog",
    date: "2026-09-02",
    readingTime: "18 min read",
    tags: ["storage", "performance", "memory"],
    excerpt:
      "Analyzing cache-line eviction, SIMD vectorization, and struct padding to achieve sub-microsecond serialization over high-throughput NVMe streams.",
  },
  {
    title: "Postmortem: Debugging a Cascading Tail-Latency Spike in Distributed Cache",
    slug: "/blog",
    date: "2026-08-14",
    readingTime: "11 min read",
    tags: ["postmortem", "sre", "networking"],
    excerpt:
      "How connection pool saturation and TCP window exhaustion triggered exponential retry storms across 40 microservice clusters.",
  },
];

const featuredProjects = [
  {
    name: "Raft-Engine-RS",
    summary:
      "A high-performance, asynchronous Raft consensus engine implemented in Rust with zero external runtime dependencies.",
    tech: ["Rust", "Tokio", "gRPC", "LSM-Tree"],
    github: "https://github.com",
    metrics: "Sub-millisecond election timeout · 85k ops/sec replication",
  },
  {
    name: "ZeroCopy-Storage",
    summary:
      "Direct I/O NVMe storage streaming pipeline utilizing io_uring and SIMD serialization for Linux kernel bypass operations.",
    tech: ["C++20", "io_uring", "Linux", "SIMD"],
    github: "https://github.com",
    metrics: "Zero heap allocations in fast-path · 4.8 GB/s sustained",
  },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Pen's Pulse — Software engineering journal, systems architecture, distributed engines, and digital garden notes."
    />
    <title>Pen's Pulse — Software Engineer Journal</title>
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <Header currentPath="/" />

    <main id="main-content">
      <!-- Profile Article Matching My Scholar -->
      <article id="profile">
        <header class="profile-header">
          <div class="profile-avatar">
            <Icon name="quill" size={32} />
          </div>
          <div class="profile-content">
            <div class="profile-heading">
              <h1 class="profile-name">Vincent</h1>
              <p class="profile-tagline">
                Systems engineer exploring distributed consensus, high-throughput storage engines,
                and low-latency runtime architecture.
              </p>
            </div>
          </div>
        </header>

        <div class="prose">
          <p>
            Welcome to my digital workshop. This site operates as an editorial archive for rigorous
            engineering essays, postmortems, and technical investigations. Designed with academic
            restraint, high-contrast typography, and zero marketing clutter.
          </p>
        </div>

        <footer class="profile-footer">
          <span class="email-link">
            <Icon name="mail" size={16} />
            <button
              type="button"
              id="copy-email-btn"
              class="copy-email-button"
              data-copy="vincent@example.dev"
              title="Copy email address"
            >
              <span id="copy-email-text">vincent@example.dev</span>
            </button>
          </span>
          <ul class="profile-social-links">
            <li>
              <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="profile-icon-btn"
                aria-label="GitHub"
              >
                <Icon name="github" size={16} />
              </a>
            </li>
            <li>
              <a href="/blog" class="profile-icon-btn" aria-label="Articles Feed">
                <Icon name="rss" size={16} />
              </a>
            </li>
          </ul>
        </footer>
      </article>

      <!-- Latest Technical Essays Section -->
      <section id="essays" class="section-block">
        <div class="section-heading">
          <h2 class="section-title">最新文章</h2>
          <a href="/blog" class="section-more">
            <span>see all</span>
            <Icon name="arrow-right" size={13} />
          </a>
        </div>

        <div class="card-list">
          {essays.map((essay) => (
            <article class="interactive-card">
              <div class="card-meta">
                <time class="meta-date">{essay.date}</time>
                <span class="meta-dot">·</span>
                <span class="meta-time">{essay.readingTime}</span>
              </div>
              <h3 class="card-title">
                <a href={essay.slug}>{essay.title}</a>
              </h3>
              <p class="card-summary">{essay.excerpt}</p>
              <div class="card-tags">
                {essay.tags.map((tag) => (
                  <Tag prefix="#" label={tag} href="/blog" />
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Selected Projects Section -->
      <section id="projects" class="section-block">
        <div class="section-heading">
          <h2 class="section-title">精選專案</h2>
          <a href="/projects" class="section-more">
            <span>see all</span>
            <Icon name="arrow-right" size={13} />
          </a>
        </div>

        <div class="card-list">
          {featuredProjects.map((project) => (
            <article class="interactive-card">
              <div class="project-head">
                <h3 class="card-title">
                  <a href={project.github} target="_blank" rel="noopener noreferrer">
                    {project.name}
                  </a>
                </h3>
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="source-link"
                  aria-label={`View ${project.name} source code on GitHub`}
                >
                  <Icon name="github" size={14} />
                  <span>Source</span>
                  <Icon name="external-link" size={12} />
                </a>
              </div>
              <p class="card-summary">{project.summary}</p>
              <div class="project-metrics">
                <span class="metrics-label">Metrics:</span>
                <span class="metrics-value">{project.metrics}</span>
              </div>
              <div class="card-tags">
                {project.tech.map((t) => (
                  <Tag label={t} />
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />

    <!-- Copy Email Script -->
    <script is:inline>
      const copyEmailBtn = document.getElementById("copy-email-btn");
      const copyEmailText = document.getElementById("copy-email-text");
      if (copyEmailBtn && copyEmailText) {
        copyEmailBtn.addEventListener("click", async () => {
          const email = copyEmailBtn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(email);
            copyEmailText.textContent = "Copied to clipboard!";
            setTimeout(() => {
              copyEmailText.textContent = "vincent@example.dev";
            }, 2000);
          } catch {
            copyEmailText.textContent = email;
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* Profile Layout Matching My Scholar */
  #profile {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);

    @media (width >= 40rem) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-m);
    }
  }

  .profile-avatar {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--primary) 12%, var(--muted));
    border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--border));
    color: var(--primary);
  }

  .profile-content {
    display: flex;
    flex-direction: column;
  }

  .profile-heading {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .profile-name {
    font-size: var(--step-3);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .profile-tagline {
    font-size: var(--step-0);
    color: var(--muted-foreground);
    line-height: 1.5;
    margin: 0;
  }

  .profile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  .copy-email-button {
    font: inherit;
    color: inherit;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--muted-foreground) 40%, transparent);
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
      text-decoration-color: var(--primary);
    }
  }

  .profile-social-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .profile-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    text-decoration: none;
    border: 1px solid var(--border);
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
      border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      background-color: color-mix(in oklab, var(--primary) 8%, transparent);
    }
  }

  /* Section Styling with My Scholar Section-Heading & see all */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2xs);
  }

  .section-title {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      gap var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
      gap: var(--space-2xs);
    }
  }

  /* Card Lists with My Scholar subtle hover depth */
  .card-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .interactive-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border-radius: var(--radius-xl);
    border: 1px solid transparent;
    transition:
      border-color var(--motion-duration) var(--motion-ease),
      background-color var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 34%, transparent);
      background-color: color-mix(in oklab, var(--muted) 45%, transparent);
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--primary) 6%, transparent),
        0 0.75rem 2rem -1.25rem color-mix(in oklab, var(--ring) 24%, transparent);
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  .meta-dot {
    opacity: 0.5;
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    margin: 0;

    a {
      color: var(--foreground);
      text-decoration: none;
      transition: color var(--motion-duration-fast) var(--motion-ease);

      &:hover {
        color: var(--primary);
      }
    }
  }

  .card-summary {
    font-size: var(--step-0);
    color: var(--muted-foreground);
    line-height: 1.65;
    margin: 0;
  }

  .card-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
    }
  }

  .project-metrics {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font-size: var(--step-xs);
    font-family: var(--font-mono);
  }

  .metrics-label {
    color: var(--muted-foreground);
    font-weight: var(--font-weight-medium);
  }

  .metrics-value {
    color: var(--foreground);
  }
</style>
