---
import AboutSection from '../components/home/about-section.astro';
import FeatureCards from '../components/home/feature-cards.astro';
import HeroSection from '../components/home/hero-section.astro';
import Layout from '../layouts/default-layout.astro';
---

<Layout>
  <!-- 主標題區域 -->
  <HeroSection />

  <div class="max-w-5xl mx-auto px-4 lg:px-8 py-12">
    <div class="space-y-3">
      <!-- 三欄式功能連結 -->
      <FeatureCards />

      <!-- 個人介紹與技能區域 -->
      <AboutSection />
    </div>
  </div>
</Layout>
