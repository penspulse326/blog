---
import "../styles/global.css";
import Callout from "../components/Callout.astro";
import Icon from "../components/Icon.astro";

const essays = [
  {
    title: "Building a Fault-Tolerant Raft Consensus Engine in Rust",
    slug: "#raft-engine",
    date: "Oct 18, 2026",
    readingTime: "14 min read",
    tags: ["systems", "rust", "consensus"],
    excerpt:
      "A deep dive into implementing state machine replication, handling network partitions, and eliminating split-brain anomalies in distributed consensus.",
  },
  {
    title: "Zero-Copy Deserialization and Memory Alignment in Storage Pipelines",
    slug: "#zero-copy-storage",
    date: "Sep 02, 2026",
    readingTime: "18 min read",
    tags: ["storage", "performance", "memory"],
    excerpt:
      "Analyzing cache-line eviction, SIMD vectorization, and struct padding to achieve sub-microsecond serialization over high-throughput NVMe streams.",
  },
  {
    title: "Postmortem: Debugging a Cascading Tail-Latency Spike in Distributed Cache",
    slug: "#tail-latency-postmortem",
    date: "Aug 14, 2026",
    readingTime: "11 min read",
    tags: ["postmortem", "sre", "networking"],
    excerpt:
      "How connection pool saturation and TCP window exhaustion triggered exponential retry storms across 40 microservice clusters.",
  },
];

const sampleCode = `pub async fn elect_leader(&mut self) -> Result<Leadership, RaftError> {
    self.state = NodeState::Candidate;
    self.current_term += 1;
    self.voted_for = Some(self.node_id);

    let votes = self.broadcast_request_vote().await?;
    if votes.is_majority(self.cluster_size) {
        self.become_leader();
        Ok(Leadership::Won)
    } else {
        Err(RaftError::ElectionSplit)
    }
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Vincent — Software Engineer. Systems architecture, distributed engines, and technical essays."
    />
    <title>Vincent — Scholar SWE Codex</title>
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <a href="/" class="brand-link" aria-label="Vincent Homepage">
          <span class="monogram">V</span>
          <span class="brand-title">vincent.dev</span>
        </a>

        <nav class="masthead-nav" aria-label="Primary navigation">
          <a href="#essays" class="nav-link">
            Essays
          </a>
          <a href="#design-system" class="nav-link">
            Design System
          </a>
          <a
            href="https://github.com/mychiffonn/myscholar"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
          >
            My Scholar
          </a>

          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle color theme"
            title="Toggle color theme"
          >
            <!-- Sun icon (for dark mode) -->
            <Icon name="sun" class="icon-sun" size={18} />
            <!-- Moon icon (for light mode) -->
            <Icon name="moon" class="icon-moon" size={18} />
          </button>
        </nav>
      </div>
    </header>

    <main class="page-container">
      <!-- Profile Intro Section -->
      <section class="profile-section">
        <div class="profile-header">
          <h1 class="profile-name">
            Vincent
            <span class="status-pill">SWE</span>
          </h1>
          <p class="profile-tagline">
            Systems engineer exploring distributed consensus, high-throughput storage engines, and
            low-latency runtime architecture.
          </p>
        </div>

        <div class="prose">
          <p>
            Welcome to my digital workshop. This site operates as an editorial archive for rigorous
            engineering essays, postmortems, and technical investigations. Designed with academic
            restraint, high-contrast code notation, and zero marketing clutter.
          </p>
          <p>
            You can verify the active design guidelines, inspect live OKLCH theming, test typography
            measure, or toggle color themes below.
          </p>
        </div>

        <div class="profile-actions">
          <button
            type="button"
            id="copy-email-btn"
            class="action-button action-button-secondary"
            data-copy="vincent@example.dev"
            title="Copy email address"
          >
            <Icon name="copy" size={16} />
            <span id="copy-email-text">Copy Email</span>
          </button>

          <a
            href="https://github.com/mychiffonn/myscholar"
            target="_blank"
            rel="noopener noreferrer"
            class="action-button action-button-primary"
          >
            <span>Reference Theme</span>
            <Icon name="external-link" size={15} />
          </a>
        </div>
      </section>

      <hr class="divider" />

      <!-- Essays List Section -->
      <section id="essays" class="section-block">
        <h2 class="section-title">Technical Essays</h2>
        <div class="essay-list">
          {essays.map((essay) => (
            <article class="essay-card">
              <div class="essay-meta">
                <time class="essay-date">{essay.date}</time>
                <span class="meta-separator">·</span>
                <span class="essay-reading-time">{essay.readingTime}</span>
              </div>
              <h3 class="essay-title">
                <a href={essay.slug}>{essay.title}</a>
              </h3>
              <p class="essay-excerpt">{essay.excerpt}</p>
              <div class="tag-row">
                {essay.tags.map((tag) => (
                  <span class="tag-pill">#{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <hr class="divider" />

      <!-- Design System Calibration Showcase Section -->
      <section id="design-system" class="section-block">
        <h2 class="section-title">Design System & Settings Check</h2>
        <p class="section-description">
          This surface exercises the core guidelines defined in <code>DESIGN.md</code>
          and <code>PRODUCT.md</code>:
        </p>

        <!-- Live Color Palette Check -->
        <div class="swatch-grid">
          <div class="swatch-item">
            <div class="swatch-box swatch-bg"></div>
            <div class="swatch-label">Canvas Background</div>
            <div class="swatch-token">--background</div>
          </div>
          <div class="swatch-item">
            <div class="swatch-box swatch-fg"></div>
            <div class="swatch-label">Prose Foreground</div>
            <div class="swatch-token">--foreground</div>
          </div>
          <div class="swatch-item">
            <div class="swatch-box swatch-primary"></div>
            <div class="swatch-label">Pine Mint</div>
            <div class="swatch-token">--primary</div>
          </div>
          <div class="swatch-item">
            <div class="swatch-box swatch-accent"></div>
            <div class="swatch-label">Emerald Jade</div>
            <div class="swatch-token">--accent</div>
          </div>
          <div class="swatch-item">
            <div class="swatch-box swatch-muted"></div>
            <div class="swatch-label">Muted Recessed</div>
            <div class="swatch-token">--muted</div>
          </div>
          <div class="swatch-item">
            <div class="swatch-box swatch-border"></div>
            <div class="swatch-label">Hairline Border</div>
            <div class="swatch-token">--border</div>
          </div>
        </div>

        <!-- Expressive Code Block Component -->
        <div class="code-component-container">
          <div class="code-header">
            <div class="code-header-left">
              <span class="code-lang-pill">RUST</span>
              <span class="code-file-name">consensus/raft.rs</span>
            </div>
            <button type="button" id="copy-code-btn" class="code-copy-btn" title="Copy code">
              <Icon id="copy-code-icon" name="copy" size={14} />
              <span id="copy-code-text">Copy</span>
            </button>
          </div>
          <pre class="code-pre"><code><span class="code-line"><span class="code-num">1</span> <span class="tok-keyword">pub async fn</span> <span class="tok-fn">elect_leader</span>(&amp;<span class="tok-keyword">mut self</span>) -&gt; <span class="tok-type">Result</span>&lt;<span class="tok-type">Leadership</span>, <span class="tok-type">RaftError</span>&gt; &#123;</span>
<span class="code-line"><span class="code-num">2</span>     <span class="tok-keyword">self</span>.state = <span class="tok-type">NodeState</span>::Candidate;</span>
<span class="code-line"><span class="code-num">3</span>     <span class="tok-keyword">self</span>.current_term += <span class="tok-num">1</span>;</span>
<span class="code-line"><span class="code-num">4</span>     <span class="tok-keyword">self</span>.voted_for = <span class="tok-type">Some</span>(<span class="tok-keyword">self</span>.node_id);</span>
<span class="code-line code-line-highlight"><span class="code-num">5</span>     <span class="tok-keyword">let</span> votes = <span class="tok-keyword">self</span>.<span class="tok-fn">broadcast_request_vote</span>().<span class="tok-keyword">await</span>?;</span>
<span class="code-line"><span class="code-num">6</span>     <span class="tok-keyword">if</span> votes.<span class="tok-fn">is_majority</span>(<span class="tok-keyword">self</span>.cluster_size) &#123;</span>
<span class="code-line"><span class="code-num">7</span>         <span class="tok-keyword">self</span>.<span class="tok-fn">become_leader</span>();</span>
<span class="code-line"><span class="code-num">8</span>         <span class="tok-type">Ok</span>(<span class="tok-type">Leadership</span>::Won)</span>
<span class="code-line"><span class="code-num">9</span>     &#125; <span class="tok-keyword">else</span> &#123;</span>
<span class="code-line"><span class="code-num">10</span>        <span class="tok-type">Err</span>(<span class="tok-type">RaftError</span>::ElectionSplit)</span>
<span class="code-line"><span class="code-num">11</span>    &#125;</span>
<span class="code-line"><span class="code-num">12</span> &#125;</span></code></pre>
        </div>

        <!-- Callout Box Component (Extracted from myscholar) -->
        <Callout variant="note" title="Architectural Invariant (Rarity & Quorum Rule)">
          <p>
            Leader election requires a strict majority quorum
            <code class="inline-code">N/2 + 1</code>. Accent highlights like
            <strong class="text-primary">Pine Mint</strong> and{" "}
            <strong class="text-accent">Emerald Jade</strong> are deliberately restricted to &le;5%
            of the viewport area to safeguard uninterrupted reading immersion.
          </p>
        </Callout>

        <!-- Bilingual CJK Typographic Harmony Test -->
        <div class="cjk-test-box">
          <div class="cjk-badge">Bilingual Typography Test (繁體中文 / CJK)</div>
          <p class="cjk-prose">
            分散式系統的一致性協議旨在異步網路中達成確定性決策。本站採用
            <code>DM Sans</code> 搭配 <code>PingFang TC</code> 與 <code>Noto Sans CJK TC</code>
            ，確保繁體中文排版在 1.75 倍行高、自然字距與雙向對齊上，皆能與英文技術術語無縫契合。
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-copy">
          &copy; 2026 Vincent. Built with Astro 7 &amp; OKLCH tokens. Inspired by{" "}
          <a
            href="https://github.com/mychiffonn/myscholar"
            target="_blank"
            rel="noopener noreferrer"
          >
            My Scholar
          </a>
          .
        </p>
        <div class="footer-links">
          <a href="#essays">Essays</a>
          <span class="footer-dot">·</span>
          <a href="#design-system">Guidelines</a>
          <span class="footer-dot">·</span>
          <a href="https://myscholar.pages.dev/" target="_blank" rel="noopener noreferrer">
            Reference Demo
          </a>
        </div>
      </div>
    </footer>

    <!-- Interactive script for Theme Toggle & Copy Buttons -->
    <script is:inline define:vars={{ sampleCode }}>
      // Theme toggle functionality
      const toggleBtn = document.getElementById("theme-toggle");
      if (toggleBtn) {
        toggleBtn.addEventListener("click", () => {
          const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
          const newTheme = currentTheme === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", newTheme);
          localStorage.setItem("theme", newTheme);
        });
      }

      // Copy Email functionality
      const copyEmailBtn = document.getElementById("copy-email-btn");
      const copyEmailText = document.getElementById("copy-email-text");
      if (copyEmailBtn && copyEmailText) {
        copyEmailBtn.addEventListener("click", async () => {
          const email = copyEmailBtn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(email);
            copyEmailText.textContent = "Copied!";
            setTimeout(() => {
              copyEmailText.textContent = "Copy Email";
            }, 2000);
          } catch {
            copyEmailText.textContent = email;
          }
        });
      }

      // Copy Code functionality
      const copyCodeBtn = document.getElementById("copy-code-btn");
      const copyCodeText = document.getElementById("copy-code-text");
      if (copyCodeBtn && copyCodeText) {
        copyCodeBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(sampleCode);
            copyCodeText.textContent = "Copied!";
            setTimeout(() => {
              copyCodeText.textContent = "Copy";
            }, 2000);
          } catch {
            copyCodeText.textContent = "Copied";
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* Header & Masthead */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(12px);
  }

  .masthead-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--foreground);
    font-weight: var(--font-weight-bold);
    font-size: var(--step-0);
  }

  .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sm);
    background: var(--muted);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--primary);
  }

  .masthead-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--foreground);
    }
  }

  /* Theme Toggle Button */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-size-compact);
    height: var(--control-size-compact);
    border-radius: var(--radius-md);
    background: var(--muted);
    border: 1px solid var(--border);
    color: var(--foreground);
    cursor: pointer;
    transition:
      background-color var(--motion-duration-fast) var(--motion-ease),
      border-color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  :global([data-theme="light"]) .icon-sun {
    display: none;
  }

  :global([data-theme="light"]) .icon-moon {
    display: block;
  }

  /* Page Container */
  .page-container {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  /* Profile Header */
  .profile-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .profile-name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step-4);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--primary) 15%, var(--muted));
    color: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 35%, var(--border));
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    font-weight: var(--font-weight-semibold);
  }

  .profile-tagline {
    font-size: var(--step-1);
    color: var(--muted-foreground);
    line-height: 1.45;
  }

  .profile-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: var(--step-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);
  }

  .action-button-primary {
    background: var(--primary);
    color: var(--primary-foreground);
    border: 1px solid transparent;

    &:hover {
      opacity: 0.9;
    }
  }

  .action-button-secondary {
    background: var(--muted);
    color: var(--foreground);
    border: 1px solid var(--border);

    &:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3.5rem 0;
  }

  /* Section Styling */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-title {
    font-size: var(--step-2);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
  }

  .section-description {
    color: var(--muted-foreground);
    font-size: var(--step-0);
    margin-top: -0.5rem;

    code {
      font-family: var(--font-mono);
      font-size: var(--step-xs);
      padding: 0.15em 0.35em;
      background: var(--muted);
      border-radius: var(--radius-xs);
      border: 1px solid var(--border);
    }
  }

  /* Essay List & Cards */
  .essay-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .essay-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .essay-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  .meta-separator {
    opacity: 0.5;
  }

  .essay-title {
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;

    a {
      color: var(--foreground);
      text-decoration-color: var(--muted-foreground);

      &:hover {
        color: var(--accent);
      }
    }
  }

  .essay-excerpt {
    font-size: var(--step-0);
    color: var(--prose-foreground);
    line-height: 1.6;
  }

  .tag-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--muted);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  /* Swatch Grid for live theme test */
  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .swatch-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
  }

  .swatch-box {
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .swatch-bg {
    background: var(--background);
  }

  .swatch-fg {
    background: var(--foreground);
  }

  .swatch-primary {
    background: var(--primary);
  }

  .swatch-accent {
    background: var(--accent);
  }

  .swatch-muted {
    background: var(--muted);
  }

  .swatch-border {
    background: var(--border);
  }

  .swatch-label {
    font-size: var(--step-xs);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
  }

  .swatch-token {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  /* Code Component */
  .code-component-container {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--muted);
    margin-top: 0.5rem;
  }

  .code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--border);
    background: var(--muted);
  }

  .code-header-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .code-lang-pill {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    font-weight: var(--font-weight-bold);
    color: var(--primary);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-xs);
    border: 1px solid color-mix(in oklab, var(--primary) 40%, var(--border));
  }

  .code-file-name {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  .code-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-xs);
