---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Callout from "../components/Callout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Tag from "../components/Tag.astro";

const noteTopics = [
  {
    category: "分散式系統 (Distributed Systems)",
    notes: [
      {
        title: "Raft Log Compaction and Snapshotting Semantics",
        updated: "2026-10-20",
        summary:
          "狀態機快照（Snapshotting）在節點記憶體不足時的滾動截斷策略，以及快照傳輸與安裝（InstallSnapshot）過程中的鎖競爭優化。",
        tags: ["raft", "consensus", "storage"],
      },
      {
        title: "Vector Clocks and Causality Violation Traps",
        updated: "2026-09-15",
        summary:
          "比較 Lamport Timestamps 與 Vector Clocks 在異步網路分割下的因果順序判斷差異，與處理並行寫入衝突的經驗法則。",
        tags: ["distributed", "causality", "ordering"],
      },
    ],
  },
  {
    category: "Rust 與低延遲記憶體架構 (Rust & Memory Layout)",
    notes: [
      {
        title: "Struct Padding, Cache Lines and False Sharing",
        updated: "2026-08-30",
        summary:
          "x86-64 / ARM64 下 64-byte 快取行的顛簸現象（False Sharing），以及利用 #[repr(align(64))] 隔離原子指標的實踐數據。",
        tags: ["rust", "cache-lines", "perf"],
      },
      {
        title: "Lock-Free RingBuffer Memory Ordering (Acquire/Release)",
        updated: "2026-07-12",
        summary:
          "深入解讀 C++ / Rust 原子操作中的 Relaxed, Acquire, Release 與 SeqCst，消除硬體層指令重排對 SPSC 隊列的損壞。",
        tags: ["lock-free", "concurrency", "atomics"],
      },
    ],
  },
  {
    category: "Linux 核心與網路 (Linux Kernel & Networking)",
    notes: [
      {
        title: "io_uring SQPOLL Mode vs epoll Latency Curves",
        updated: "2026-06-25",
        summary:
          "在 NVMe 密集讀取下，核心固定輪詢執行緒（SQPOLL）如何將上下文切換（Context Switch）次數降至趨近於零。",
        tags: ["linux", "io_uring", "async-io"],
      },
      {
        title: "TCP Window Starvation in Heavy Retransmission Storms",
        updated: "2026-05-18",
        summary:
          "連線池耗盡與 TCP 擁塞窗口崩潰（Congestion Collapse）引發的級聯崩潰分析與 BBR 擁塞演算法對策。",
        tags: ["networking", "tcp", "kernel"],
      },
    ],
  },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Pen's Pulse — 工程隨筆與數位花園。分散式架構、記憶體對齊、Linux 核心與 Rust 底層筆記。"
    />
    <title>筆記 — Pen's Pulse</title>
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <Header currentPath="/notes" />

    <main id="main-content">
      <Breadcrumb items={[{ label: "筆記" }]} />

      <header class="section-header">
        <h1 class="page-title">筆記</h1>
        <p class="page-tagline">
          數位花園（Digital Garden）工作流：收錄尚未擴展為完整長文的架構思考、演算法證明與踩坑心得。
        </p>
      </header>

      <Callout variant="tip" title="筆記閱覽準則">
        <p>
          此處的筆記保持有機更新（Evergreen
          Notes）。標註的日期為最後修訂時間，所有程式碼片段與驗證命令皆經 Miri 與 Linux perf
          基準比對。
        </p>
      </Callout>

      <div class="topics-container">
        {noteTopics.map((topic) => (
          <section class="topic-group">
            <h2 class="topic-heading">{topic.category}</h2>
            <div class="note-cards-list">
              {topic.notes.map((note) => (
                <article class="note-entry">
                  <div class="note-entry-header">
                    <h3 class="note-entry-title">{note.title}</h3>
                    <time class="note-entry-date">{note.updated}</time>
                  </div>
                  <p class="note-entry-summary">{note.summary}</p>
                  <div class="note-tags">
                    {note.tags.map((tag) => (
                      <Tag prefix="#" label={tag} />
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .section-header {
    margin-block: var(--space-s);
  }

  .page-title {
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin-block-end: var(--space-2xs);
  }

  .page-tagline {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .topics-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .topic-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .topic-heading {
    font-size: var(--step-1);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--border);
  }

  .note-cards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .note-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border-radius: var(--radius-xl);
    background-color: var(--muted);
    border: 1px solid var(--border);
    transition:
      border-color var(--motion-duration) var(--motion-ease),
      background-color var(--motion-duration) var(--motion-ease),
      box-shadow var(--motion-duration) var(--motion-ease);

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 34%, transparent);
      background-color: color-mix(in oklab, var(--muted) 70%, transparent);
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--primary) 6%, transparent),
        0 0.75rem 2rem -1.25rem color-mix(in oklab, var(--ring) 24%, transparent);
    }
  }

  .note-entry-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .note-entry-title {
    font-size: var(--step-0);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;
  }

  .note-entry-date {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  .note-entry-summary {
    font-size: var(--step-xs);
    line-height: 1.7;
    color: var(--muted-foreground);
    margin: 0;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }
</style>
