---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import TaxonomyChip from "../components/TaxonomyChip.astro";
import NoteCard from "../components/NoteCard.astro";
import { getAllNotes, getSortedNoteCategories } from "../lib/content";

const allNotes = await getAllNotes();
const sortedCategories = getSortedNoteCategories(allNotes);

// Pick the 10 most recent notes sorted by date descending
const recentNotes = [...allNotes]
  .sort((a, b) => {
    const timeA = a.date ? a.date.getTime() : 0;
    const timeB = b.date ? b.date.getTime() : 0;
    if (timeA !== timeB) return timeB - timeA;
    return a.title.localeCompare(b.title);
  })
  .slice(0, 10);
---

<Layout
  title="筆記 — Pen's Pulse"
  description="Pen's Pulse — 工程隨筆與技術筆記。涵蓋 JavaScript、React、NestJS、CSS、SQL 與前端架構。"
  currentPath="/notes"
>
  <Breadcrumb items={[{ label: "筆記", icon: "notes" }]} />

  {sortedCategories.length > 0 && (
    <nav class="notes-filters" aria-label="依主題瀏覽筆記">
      <div class="filter-group">
        <h2 class="filter-heading">依主題瀏覽</h2>
        <div class="filter-chips">
          {sortedCategories.map(({ category, count }) => (
            <TaxonomyChip
              href={`/notes/tags/${category}`}
              label={category}
              count={count}
              countNoun="篇"
            />
          ))}
        </div>
      </div>
    </nav>
  )}

  <div class="notes-index">
    <section class="recent-notes">
      <div class="section-title-row">
        <h2 class="section-title">最新筆記</h2>
        <span class="note-count">共 {allNotes.length} 篇中的最近 10 篇</span>
      </div>

      <ul class="note-list">
        {recentNotes.map((note) => (
          <li>
            <NoteCard note={note} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .notes-filters,
  .filter-group,
  .notes-index,
  .recent-notes,
  .note-list {
    display: flex;
    flex-direction: column;
  }

  .notes-filters {
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  .filter-group {
    gap: var(--space-2xs);
  }

  .filter-heading {
    color: var(--muted-foreground);
    font-size: var(--step-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .notes-index {
    min-block-size: calc(100dvh - 18rem);
    gap: var(--space-xl);
  }

  .recent-notes {
    gap: var(--space-s);
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .section-title {
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .note-count {
    color: var(--muted-foreground);
    font-size: var(--step-xs);
    margin: 0;
  }

  .note-list {
    gap: var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
