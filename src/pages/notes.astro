---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Tag from "../components/Tag.astro";
import { getAllNotes } from "../lib/content";

const allNotes = await getAllNotes();
const categoriesMap = new Map<string, typeof allNotes>();

for (const note of allNotes) {
  if (!categoriesMap.has(note.category)) {
    categoriesMap.set(note.category, []);
  }
  categoriesMap.get(note.category)!.push(note);
}

const PREFERRED_ORDER = [
  "JavaScript",
  "React",
  "CSS",
  "NestJS",
  "SQL",
  "Git",
  "Vue",
  "Test",
  "Monorepo",
  "Web animation",
  "Chart",
  "GIS",
];

const categories = Array.from(categoriesMap.keys()).sort((a, b) => {
  const indexA = PREFERRED_ORDER.indexOf(a);
  const indexB = PREFERRED_ORDER.indexOf(b);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return a.localeCompare(b);
});
---

<Layout
  title="筆記 — Pen's Pulse"
  description="Pen's Pulse — 工程隨筆與技術筆記。涵蓋 JavaScript、React、NestJS、CSS、SQL 與前端架構。"
  currentPath="/notes"
>
  <Breadcrumb items={[{ label: "筆記" }]} />

  <header class="section-header">
    <h1 class="page-title">筆記</h1>
    <p class="page-tagline">收錄前端開發、框架原理、資料庫與後端探索的日常學習筆記與踩坑記錄。</p>
  </header>

  <div class="topics-container">
    {categories.map((category) => {
      const notes = categoriesMap.get(category) || [];
      return (
        <section class="topic-group">
          <div class="topic-header">
            <h2 class="topic-heading">{category}</h2>
            <span class="topic-count">{notes.length} 篇</span>
          </div>
          <div class="note-cards-list">
            {notes.map((note) => (
              <article class="note-entry">
                <div class="note-entry-header">
                  <h3 class="note-entry-title">
                    <a href={`/notes/${note.slug}`}>{note.title}</a>
                  </h3>
                  <div class="note-entry-meta">
                    {note.dateString && <time class="note-entry-date">{note.dateString}</time>}
                    {note.dateString && <span class="meta-sep">·</span>}
                    <span class="note-reading-time">{note.readingTime}</span>
                  </div>
                </div>
                {note.description && <p class="note-entry-summary">{note.description}</p>}
                {note.tags.length > 0 && (
                  <div class="note-tags">
                    {note.tags.map((tag) => (
                      <Tag prefix="#" label={tag} />
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  .section-header {
    margin-block: var(--space-s);
  }

  .page-title {
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin-block-end: var(--space-2xs);
  }

  .page-tagline {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .topics-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .topic-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .topic-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--border);
  }

  .topic-heading {
    font-size: var(--step-1);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    margin: 0;
  }

  .topic-count {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  .note-cards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .note-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-lg);
    background-color: var(--muted);
    border: 1px solid var(--border);
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease),
      background-color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 34%, transparent);
      background-color: color-mix(in oklab, var(--muted) 70%, transparent);
    }
  }

  .note-entry-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .note-entry-title {
    font-size: var(--step-0);
    font-weight: var(--font-weight-semibold);
    color: var(--foreground);
    margin: 0;

    a {
      color: var(--foreground);
      text-decoration: none;
      transition: color var(--motion-duration-fast) var(--motion-ease);

      &:hover {
        color: var(--accent);
      }
    }
  }

  .note-entry-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
  }

  .meta-sep {
    opacity: 0.5;
  }

  .note-entry-summary {
    font-size: var(--step-xs);
    line-height: 1.6;
    color: var(--prose-foreground);
    margin: 0;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--space-3xs);
  }
</style>
