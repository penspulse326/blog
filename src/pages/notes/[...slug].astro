---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getAllNotes, type CleanNote } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const allNotes = await getAllNotes();
  return allNotes.map((note) => {
    const categoryNotes = allNotes.filter((n) => n.category === note.category);
    const currentIndex = categoryNotes.findIndex((n) => n.id === note.id);
    const prevNote = currentIndex > 0 ? categoryNotes[currentIndex - 1] : null;
    const nextNote =
      currentIndex < categoryNotes.length - 1 ? categoryNotes[currentIndex + 1] : null;

    return {
      params: { slug: note.slug },
      props: {
        note,
        prevNote: prevNote ? { title: prevNote.title, slug: prevNote.slug } : null,
        nextNote: nextNote ? { title: nextNote.title, slug: nextNote.slug } : null,
      },
    };
  });
}

interface Props {
  note: CleanNote;
  prevNote: { title: string; slug: string } | null;
  nextNote: { title: string; slug: string } | null;
}

const { note, prevNote, nextNote } = Astro.props;
const { Content, headings } = await render(note.entry);
---

<ArticleLayout
  title={note.title}
  description={note.description || `${note.category} 筆記 - ${note.title}`}
  currentPath="/notes"
  headings={headings}
  breadcrumbItems={[
    { label: "筆記", href: "/notes", icon: "notes" },
    { label: note.category, href: `/notes/tags/${note.category}` },
    { label: note.title },
  ]}
  dateString={note.dateString}
  date={note.date}
  readingTime={note.readingTime}
  prevPost={prevNote}
  nextPost={nextNote}
  backLink={{ href: "/notes", label: "返回筆記列表" }}
>
  <div slot="header-top" class="category-badge-row">
    <a href={`/notes/tags/${note.category}`} class="category-badge">
      #{note.category}
    </a>
    {note.subCategory && <span class="sub-category-badge">{note.subCategory}</span>}
  </div>

  <Content />
</ArticleLayout>
