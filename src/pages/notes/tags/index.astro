---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import TaxonomyChip from "../../../components/TaxonomyChip.astro";
import { getAllNotes, getSortedNoteCategories } from "../../../lib/content";

const allNotes = await getAllNotes();
const sortedCategories = getSortedNoteCategories(allNotes);
---

<Layout title="主題 — Pen's Pulse" description="Pen's Pulse — 所有筆記主題" currentPath="/notes">
  <Breadcrumb
    items={[
      { label: "筆記", icon: "notes", href: "/notes" },
      { label: "主題", icon: "tags" },
    ]}
  />

  <nav class="tag-cloud" aria-label="所有筆記主題">
    {sortedCategories.map(({ category, count }) => (
      <TaxonomyChip
        href={`/notes/tags/${category}`}
        label={category}
        count={count}
        countNoun="篇"
      />
    ))}
  </nav>
</Layout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
