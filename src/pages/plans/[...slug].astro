---
import type { PlanEntry } from '../../utils/plans';

import ArticleHeader from '../../components/common/article-header.astro';
import GiscusComment from '../../components/common/giscus-comment.astro';
import TableOfContents from '../../components/toc/table-of-contents.astro';
import ArticleLayout from '../../layouts/article-layout.astro';
import { getAllPlans, getNavigation } from '../../utils/plans';

export function getStaticPaths() {
  const allPlans = getAllPlans();
  return allPlans.map((plan) => ({
    params: { slug: plan.id },
    props: { plan },
  }));
}

const { plan } = Astro.props as { plan: PlanEntry };

if (!plan) {
  return Astro.redirect('/404');
}

const plansNav = getNavigation();
const navigation = plansNav.map((cat) => ({
  id: cat.id,
  items: cat.plans,
  label: cat.label,
}));
const activeId = plan.id;
const pageTitle = `${plan.frontmatter.title} | 挑戰計畫`;
const headings = await plan.getHeadings();
---

<ArticleLayout
  activeId={activeId}
  description={plan.frontmatter.description}
  headings={headings}
  navigation={navigation}
  title={pageTitle}
>
  <article class="px-2">
    <ArticleHeader date={plan.frontmatter.date} title={plan.frontmatter.title} />

    <TableOfContents headings={headings} variant="mobile" />

    <div class="markdown-body mt-8">
      <plan.Content />
    </div>

    <GiscusComment />
  </article>
</ArticleLayout>
