---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import TaxonomyChip from "../../components/TaxonomyChip.astro";
import { getAllPlans, type CleanPlan } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const allPlans = await getAllPlans();

  return allPlans.map((plan) => {
    // Find prev and next within the same series
    const seriesPlans = allPlans.filter((p) => p.series === plan.series);
    const currentIndex = seriesPlans.findIndex((p) => p.id === plan.id);
    const prevPlan = currentIndex > 0 ? seriesPlans[currentIndex - 1] : null;
    const nextPlan = currentIndex < seriesPlans.length - 1 ? seriesPlans[currentIndex + 1] : null;

    return {
      params: { slug: plan.slug },
      props: {
        plan,
        prevPlan: prevPlan
          ? { slug: prevPlan.slug, title: `Day ${prevPlan.dayNumber} - ${prevPlan.title}` }
          : null,
        nextPlan: nextPlan
          ? { slug: nextPlan.slug, title: `Day ${nextPlan.dayNumber} - ${nextPlan.title}` }
          : null,
      },
    };
  });
}

interface Props {
  plan: CleanPlan;
  prevPlan: { slug: string; title: string } | null;
  nextPlan: { slug: string; title: string } | null;
}

const { plan, prevPlan, nextPlan } = Astro.props;
const { Content, headings } = await render(plan.entry);
---

<ArticleLayout
  title={plan.title}
  description={plan.description || `${plan.seriesTitle} - ${plan.title}`}
  currentPath="/plans"
  headings={headings}
  breadcrumbItems={[
    { label: "主題計劃", href: "/plans" },
    { label: plan.seriesTitle, href: "/plans" },
    { label: `Day ${plan.dayNumber}` },
  ]}
  prevPost={prevPlan}
  nextPost={nextPlan}
  backLink={{ href: "/plans", label: "返回主題計劃" }}
>
  <div slot="header-top" class="series-badge-row">
    <span class="series-badge">{plan.seriesTitle}</span>
    <span class="day-badge">Day {plan.dayNumber}</span>
  </div>

  {plan.tags.length > 0 && (
    <ul slot="header-bottom" class="post-tags" aria-label="文章標籤">
      {plan.tags.map((tag) => (
        <li>
          <TaxonomyChip label={tag} static />
        </li>
      ))}
    </ul>
  )}

  <Content />
</ArticleLayout>
