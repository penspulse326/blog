---
import type { GetStaticPaths } from 'astro';

import ArticleHeader from '../../components/common/article-header.astro';
import BackButton from '../../components/common/back-button.astro';
import GiscusComment from '../../components/common/giscus-comment.astro';
import PostsSidebar from '../../components/posts/posts-sidebar.astro';
import TableOfContents from '../../components/toc/table-of-contents.astro';
import ArticleLayout from '../../layouts/article-layout.astro';
import { getAllPosts, getRecentPosts, getTagCloud } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = getAllPosts();

  return posts.map((post) => {
    return {
      params: {
        slug: post.slug,
      },
      props: {
        post,
      },
    };
  });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, getHeadings } = post;
const headings = await getHeadings();

// 側邊欄資料
const recentPosts = getRecentPosts(5);
const tagCloud = getTagCloud();
---

<ArticleLayout
  description={post.frontmatter.description || post.frontmatter.title}
  headings={headings}
  title={post.frontmatter.title}
>
  <PostsSidebar activeId={post.id} recentPosts={recentPosts} slot="sidebar" tagCloud={tagCloud} />

  <article class="px-2 lg:px-4">
    <ArticleHeader
      backHref="/posts"
      backText="返回"
      date={post.frontmatter.date}
      showBackButton={true}
      tags={post.frontmatter.tags}
      title={post.frontmatter.title}
    />

    <TableOfContents headings={headings} variant="mobile" />

    <div class="markdown-body">
      <Content />
    </div>

    <footer class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-start">
      <BackButton href="/posts" text="返回文章列表" variant="regular" />
    </footer>

    <GiscusComment />
  </article>
</ArticleLayout>
