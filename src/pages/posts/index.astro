---
import type { Page } from 'astro';

import Pagination from '../../components/common/pagination.astro';
import PostCard from '../../components/posts/post-card.astro';
import PostsSidebar from '../../components/posts/posts-sidebar.astro';
import ArticleLayout from '../../layouts/article-layout.astro';
import { getPostsSortedByDate, getRecentPosts, getTagCloud, type PostEntry } from '../../utils/posts';

const allPosts = getPostsSortedByDate();
const pageSize = 5;
const totalPages = Math.ceil(allPosts.length / pageSize);

// 模擬第一頁的 page 物件
const page: Page<PostEntry> = {
  currentPage: 1,
  data: allPosts.slice(0, pageSize),
  end: Math.min(pageSize - 1, allPosts.length - 1),
  lastPage: totalPages,
  size: pageSize,
  start: 0,
  total: allPosts.length,
  url: {
    current: '/posts',
    first: undefined,
    last: totalPages > 1 ? `/posts/${totalPages}` : undefined,
    next: totalPages > 1 ? '/posts/2' : undefined,
    prev: undefined,
  },
};

// 側邊欄資料
const recentPosts = getRecentPosts(5);
const tagCloud = getTagCloud();
---

<ArticleLayout description="與職涯、工作、活動等相關的文章" showToc={false} title="文章">
  <PostsSidebar recentPosts={recentPosts} slot="sidebar" tagCloud={tagCloud} />

  <div class="px-2">
    <!-- 文章列表 -->
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <!-- 分頁 -->
    <Pagination baseUrl="/posts" page={page} />
  </div>
</ArticleLayout>
