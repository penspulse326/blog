---
import type { GetStaticPaths, Page } from 'astro';

import Pagination from '../../../components/common/pagination.astro';
import PostCard from '../../../components/posts/post-card.astro';
import PostsSidebar from '../../../components/posts/posts-sidebar.astro';
import TagHeader from '../../../components/posts/tag-header.astro';
import ArticleLayout from '../../../layouts/article-layout.astro';
import { getAllTags, getPostsSortedByDate, getRecentPosts, getTagCloud, type PostEntry } from '../../../utils/posts';

export const getStaticPaths = (async () => {
  const allPosts = getPostsSortedByDate();
  const tags = Array.from(getAllTags().keys());
  const paths: Array<{ params: { tag: string }; props: { tag: string } }> = [];

  // 為每個標籤生成路徑
  for (const tag of tags) {
    const filteredPosts = allPosts.filter((post) => post.frontmatter.tags?.some((t) => t === tag));

    if (filteredPosts.length > 0) {
      paths.push({
        params: { tag },
        props: { tag },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
}

const { tag } = Astro.props;

const allPosts = getPostsSortedByDate();
const filteredPosts = allPosts.filter((post) => post.frontmatter.tags?.some((t) => t === tag));

const pageSize = 5;
const totalPages = Math.ceil(filteredPosts.length / pageSize);

// 模擬第一頁的 page 物件
const page: Page<PostEntry> = {
  currentPage: 1,
  data: filteredPosts.slice(0, pageSize),
  end: Math.min(pageSize - 1, filteredPosts.length - 1),
  lastPage: totalPages,
  size: pageSize,
  start: 0,
  total: filteredPosts.length,
  url: {
    current: `/posts/tag/${encodeURIComponent(tag)}`,
    first: undefined,
    last: totalPages > 1 ? `/posts/tag/${encodeURIComponent(tag)}/${totalPages}` : undefined,
    next: totalPages > 1 ? `/posts/tag/${encodeURIComponent(tag)}/2` : undefined,
    prev: undefined,
  },
};

// 側邊欄資料
const recentPosts = getRecentPosts(5);
const tagCloud = getTagCloud();
---

<ArticleLayout description={`標籤「${tag}」相關的文章`} showToc={false} title={`標籤：${tag}`}>
  <PostsSidebar recentPosts={recentPosts} slot="sidebar" tagCloud={tagCloud} />

  <div class="px-2">
    <!-- 標籤標題 -->
    <TagHeader tag={tag} total={filteredPosts.length} />

    <!-- 文章列表 -->
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <!-- 分頁 -->
    <Pagination baseUrl={`/posts/tag/${encodeURIComponent(tag)}`} page={page} />
  </div>
</ArticleLayout>
