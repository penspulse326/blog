---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Icon from "../components/Icon.astro";

const projects = [
  {
    name: "Raft-Engine-RS",
    role: "Author",
    status: "Active",
    summary:
      "A high-performance, asynchronous Raft consensus engine implemented in Rust with zero external runtime dependencies.",
    tech: ["Rust", "Tokio", "gRPC", "LSM-Tree"],
    github: "https://github.com",
    metrics: "Sub-millisecond election timeout · 85k ops/sec log replication",
  },
  {
    name: "ZeroCopy-Storage",
    role: "Core Contributor",
    status: "Production",
    summary:
      "Direct I/O NVMe storage streaming pipeline utilizing io_uring and SIMD serialization for Linux kernel bypass operations.",
    tech: ["C++20", "io_uring", "Linux", "SIMD"],
    github: "https://github.com",
    metrics: "Zero heap allocations in fast-path · 4.8 GB/s sustained throughput",
  },
  {
    name: "Pulse-Trace",
    role: "Author",
    status: "Maintained",
    summary:
      "eBPF-driven distributed tracing agent capturing microservice connection pool anomalies and kernel TCP socket buffer exhaustions.",
    tech: ["eBPF", "Rust", "BCC", "OpenTelemetry"],
    github: "https://github.com",
    metrics: "<0.5% CPU overhead on production nodes",
  },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Pen's Pulse — 專案彙整。分散式共識系統、底層儲存引擎與高吞吐基礎設施開源專案。"
    />
    <title>專案 — Pen's Pulse</title>
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <Header currentPath="/projects" />

    <main id="main-content">
      <Breadcrumb items={[{ label: "專案" }]} />

      <header class="section-header">
        <h1 class="page-title">
          <span>專案</span>
          <span class="sub-badge">Projects</span>
        </h1>
        <p class="page-tagline">
          聚焦於高可靠性分散式系統、非同步運行環境與核心儲存管道的開源實踐與研究型原型。
        </p>
      </header>

      <section class="project-list">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-card-header">
              <div class="project-title-group">
                <h2 class="project-name">{project.name}</h2>
                <span class="status-indicator">{project.status}</span>
              </div>
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                aria-label={`View ${project.name} on GitHub`}
              >
                <Icon name="github" size={16} />
                <span>GitHub</span>
                <Icon name="external-link" size={14} />
              </a>
            </div>

            <p class="project-summary">{project.summary}</p>

            <div class="project-metrics">
              <span class="metrics-label">效能指標:</span>
              <span class="metrics-value">{project.metrics}</span>
            </div>

            <div class="tech-row">
              {project.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </article>
        ))}
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .section-header {
    margin-block: var(--space-s);
  }

  .page-title {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step-3);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-tight);
    margin-block-end: var(--space-2xs);
  }

  .sub-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--primary) 12%, var(--muted));
    color: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 25%, var(--border));
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    font-weight: var(--font-weight-medium);
  }

  .page-tagline {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background-color: var(--card);
    transition:
      border-color var(--motion-duration-fast) var(--motion-ease),
      box-shadow var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      box-shadow: 0 4px 16px -4px rgb(0 0 0 / 5%);
    }
  }

  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-title-group {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .project-name {
    font-size: var(--step-1);
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    margin: 0;
  }

  .status-indicator {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-xs);
    background: color-mix(in oklab, var(--accent) 15%, var(--muted));
    color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 30%, var(--border));
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);

    &:hover {
      color: var(--primary);
    }
  }

  .project-summary {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--muted-foreground);
    margin: 0;
  }

  .project-metrics {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
    background-color: var(--muted);
    font-size: var(--step-xs);
    font-family: var(--font-mono);
  }

  .metrics-label {
    color: var(--muted-foreground);
    font-weight: var(--font-weight-medium);
  }

  .metrics-value {
    color: var(--foreground);
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--muted-foreground);
    background: color-mix(in oklab, var(--muted) 70%, transparent);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border);
  }
</style>
